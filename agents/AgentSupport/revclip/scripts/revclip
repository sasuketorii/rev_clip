#!/usr/bin/env python3
"""Manage templates and settings in the running Revclip or revclip-demo app. JSON output; no direct DB access."""
import argparse
import base64
import json
import os
from pathlib import Path
import socket
import stat
import struct
import sys


def read_file(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError('Input must be a regular file')
        data = stream.read(limit + 1)
    if len(data) > limit:
        raise ValueError('Input exceeds size limit')
    return data


def receive(sock, length):
    data = bytearray()
    while len(data) < length:
        chunk = sock.recv(length - len(data))
        if not chunk:
            raise ConnectionError('App closed the connection')
        data.extend(chunk)
    return data


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--app', choices=('revclip-demo', 'Revclip'), default='revclip-demo', help='Target app; defaults to the isolated demo')
    commands = parser.add_subparsers(dest='op', required=True)
    commands.add_parser('settings-schema')
    commands.add_parser('settings-get').add_argument('--key')
    settings = commands.add_parser('settings-set')
    values = settings.add_mutually_exclusive_group(required=True)
    values.add_argument('--json', dest='settings_json', help='JSON object of settings to apply')
    values.add_argument('--file', dest='settings_file', help='UTF-8 JSON file, or - for stdin')
    commands.add_parser('app-action').add_argument('action', help='Action from settings-schema; may present macOS UI')
    report = commands.add_parser('bug-report', help='Send a report and source information to support via Cloudflare/Telegram')
    report.add_argument('--title', required=True)
    description = report.add_mutually_exclusive_group(required=True)
    description.add_argument('--description')
    description.add_argument('--description-file', help='UTF-8 file, or - for stdin')
    report.add_argument('--contact', default='')
    report.add_argument('--consent-source-info', dest='source_info_consent', action='store_true', required=True,
                        help='Explicit consent to send IP, region, network, language, timezone and app/OS information')
    commands.add_parser('folders')
    commands.add_parser('folder-create').add_argument('--title', required=True)
    commands.add_parser('folder-delete').add_argument('id', help='Empty folder ID')
    commands.add_parser('list').add_argument('--folder')
    commands.add_parser('get').add_argument('id')
    commands.add_parser('delete').add_argument('id')
    for name in ('create', 'update'):
        command = commands.add_parser(name)
        if name == 'update':
            command.add_argument('id')
        command.add_argument('--folder', required=name == 'create')
        command.add_argument('--title', required=name == 'create')
        content = command.add_mutually_exclusive_group(required=name == 'create')
        content.add_argument('--content')
        content.add_argument('--content-file', help='UTF-8 file, or - for stdin')
        content.add_argument('--image', help='Image file; embedded in template')
        command.add_argument('--enabled', choices=('true', 'false'))
    args = vars(parser.parse_args())
    app = args.pop('app')
    request = {key: value for key, value in args.items() if value is not None}
    if 'description_file' in request:
        filename = request.pop('description_file')
        raw = sys.stdin.buffer.read(16385) if filename == '-' else read_file(filename, 16384)
        if len(raw) > 16384:
            raise ValueError('Report input exceeds 16 KiB')
        request['description'] = raw.decode('utf-8')
    if request['op'] == 'bug-report':
        for key, limit in (('title', 120), ('description', 2500), ('contact', 200)):
            value = request[key].strip()
            if (key != 'contact' and not value) or len(value.encode('utf-16-le')) // 2 > limit:
                raise ValueError('Invalid report field: ' + key)
            request[key] = value
    if 'settings_file' in request:
        filename = request.pop('settings_file')
        raw = sys.stdin.buffer.read(1024 * 1024 + 1) if filename == '-' else read_file(filename, 1024 * 1024)
        if len(raw) > 1024 * 1024:
            raise ValueError('Settings input exceeds 1 MiB')
        request['settings_json'] = raw.decode('utf-8')
    if 'settings_json' in request:
        def unique_object(pairs):
            result = {}
            for key, value in pairs:
                if key in result:
                    raise ValueError('Duplicate JSON key: ' + key)
                result[key] = value
            return result
        def invalid_constant(value):
            raise ValueError('Non-finite JSON number: ' + value)
        request['values'] = json.loads(request.pop('settings_json'), object_pairs_hook=unique_object, parse_constant=invalid_constant)
        if not isinstance(request['values'], dict) or not request['values']:
            raise ValueError('Settings must be a nonempty JSON object')
    if 'content_file' in request:
        path = request.pop('content_file')
        data = sys.stdin.buffer.read(1024 * 1024 + 1) if path == '-' else read_file(path, 1024 * 1024)
        if len(data) > 1024 * 1024:
            raise ValueError('Text exceeds 1 MiB')
        request['content'] = data.decode('utf-8')
    if 'image' in request:
        request['image_base64'] = base64.b64encode(read_file(request.pop('image'), 10 * 1024 * 1024)).decode('ascii')
    if 'enabled' in request:
        request['enabled'] = request['enabled'] == 'true'
    payload = json.dumps(request, ensure_ascii=False).encode('utf-8')
    if len(payload) > 16 * 1024 * 1024:
        raise ValueError('Request exceeds 16 MiB')
    path = Path.home() / 'Library/Application Support' / app / 'cli.sock'
    try:
        info = path.lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            raise ValueError('Invalid app socket owner or type')
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(25 if request['op'] == 'bug-report' else 15)
            sock.connect(str(path))
            sock.sendall(struct.pack('!I', len(payload)) + payload)
            size = struct.unpack('!I', receive(sock, 4))[0]
            if size > 32 * 1024 * 1024:
                raise ValueError('Response exceeds size limit')
            response = json.loads(receive(sock, size))
    except (FileNotFoundError, ConnectionRefusedError) as exc:
        raise ValueError(f'Start the updated {app}.app first') from exc
    print(json.dumps(response, ensure_ascii=False, indent=2))
    return 0 if response.get('ok') else 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, ConnectionError) as error:
        print(json.dumps({'ok': False, 'error': str(error),
                          'note': 'If a write timed out, list/get before retrying; it may have completed.'}, ensure_ascii=False))
        sys.exit(1)
