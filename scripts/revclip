#!/usr/bin/env python3
"""Manage templates in the running Revclip or revclip-demo app. JSON output; no direct DB access."""
import argparse
import base64
import json
import os
from pathlib import Path
import socket
import stat
import struct
import sys


def read_file(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError('Input must be a regular file')
        data = stream.read(limit + 1)
    if len(data) > limit:
        raise ValueError('Input exceeds size limit')
    return data


def receive(sock, length):
    data = bytearray()
    while len(data) < length:
        chunk = sock.recv(length - len(data))
        if not chunk:
            raise ConnectionError('App closed the connection')
        data.extend(chunk)
    return data


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--app', choices=('revclip-demo', 'Revclip'), default='revclip-demo', help='Target app; defaults to the isolated demo')
    commands = parser.add_subparsers(dest='op', required=True)
    commands.add_parser('folders')
    commands.add_parser('folder-create').add_argument('--title', required=True)
    commands.add_parser('folder-delete').add_argument('id', help='Empty folder ID')
    commands.add_parser('list').add_argument('--folder')
    commands.add_parser('get').add_argument('id')
    commands.add_parser('delete').add_argument('id')
    for name in ('create', 'update'):
        command = commands.add_parser(name)
        if name == 'update':
            command.add_argument('id')
        command.add_argument('--folder', required=name == 'create')
        command.add_argument('--title', required=name == 'create')
        content = command.add_mutually_exclusive_group(required=name == 'create')
        content.add_argument('--content')
        content.add_argument('--content-file', help='UTF-8 file, or - for stdin')
        content.add_argument('--image', help='Image file; embedded in template')
        command.add_argument('--enabled', choices=('true', 'false'))
    args = vars(parser.parse_args())
    app = args.pop('app')
    request = {key: value for key, value in args.items() if value is not None}
    if 'content_file' in request:
        path = request.pop('content_file')
        data = sys.stdin.buffer.read(1024 * 1024 + 1) if path == '-' else read_file(path, 1024 * 1024)
        if len(data) > 1024 * 1024:
            raise ValueError('Text exceeds 1 MiB')
        request['content'] = data.decode('utf-8')
    if 'image' in request:
        request['image_base64'] = base64.b64encode(read_file(request.pop('image'), 10 * 1024 * 1024)).decode('ascii')
    if 'enabled' in request:
        request['enabled'] = request['enabled'] == 'true'
    payload = json.dumps(request, ensure_ascii=False).encode('utf-8')
    if len(payload) > 16 * 1024 * 1024:
        raise ValueError('Request exceeds 16 MiB')
    path = Path.home() / 'Library/Application Support' / app / 'cli.sock'
    try:
        info = path.lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            raise ValueError('Invalid app socket owner or type')
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(15)
            sock.connect(str(path))
            sock.sendall(struct.pack('!I', len(payload)) + payload)
            size = struct.unpack('!I', receive(sock, 4))[0]
            if size > 32 * 1024 * 1024:
                raise ValueError('Response exceeds size limit')
            response = json.loads(receive(sock, size))
    except (FileNotFoundError, ConnectionRefusedError) as exc:
        raise ValueError(f'Start the updated {app}.app first') from exc
    print(json.dumps(response, ensure_ascii=False, indent=2))
    return 0 if response.get('ok') else 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, ConnectionError) as error:
        print(json.dumps({'ok': False, 'error': str(error),
                          'note': 'If a write timed out, list/get before retrying; it may have completed.'}, ensure_ascii=False))
        sys.exit(1)
