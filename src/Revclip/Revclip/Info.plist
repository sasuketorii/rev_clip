	<string>Revclip temporarily captures the display to recognize text in the area you select. Images are processed on your Mac and are not saved or sent.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>$(RC_SERVICE_MENU_TITLE)</string>
			</dict>
			<key>NSMessage</key>
			<string>insertFromRevclip</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSReturnTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSTimeout</key>
			<string>60000</string>
		</dict>
	</array>
	<key>RCBugReportURL</key>
	<string>https://revclip-feedback.sasuketorii-business.workers.dev/report</string>
	<key>RCStorageDirectoryName</key>
	<string>$(RC_STORAGE_DIRECTORY_NAME)</string>
	<key>SUFeedURL</key>
	<string>$(RC_SU_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(RC_SU_PUBLIC_ED_KEY)</string>
