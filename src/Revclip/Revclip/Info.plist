	<true/>
	<key>NSAccessibilityUsageDescription</key>
	<string>Revclip needs accessibility access to paste clipboard items into other applications.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2024-2026 Revclip. Licensed under AGPL-3.0-only; see THIRD_PARTY_NOTICES.md for prior code.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
